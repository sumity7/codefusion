PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/codefusion
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development
DEV_OTP=true
RESEND_API_KEY=
MAIL_FROM=
PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Slack/Discord incoming webhook for server error alerts
ERROR_WEBHOOK_URL=
# Number of reverse proxies in front of the API (Render = 1). Used for per-IP rate limits.
TRUST_PROXY=1
# Public URLs used in emails (links back to the site, and the unsubscribe endpoint)
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000
# Optional: Chrome/Chromium for `npm run thumbnails` (otherwise Playwright's own)
CHROME_PATH=
